{
  "name": "harbor-console-web",
  "version": "0.1.0",
  "private": true,
  "description": "React web client for the embedded Harbor Console",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"tests/**/*.cjs\" \"*.{mts,mjs,json,html}\" \"../scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"tests/**/*.cjs\" \"*.{mts,mjs,json,html}\" \"../scripts/**/*.mjs\"",
    "lint": "eslint src e2e *.config.mts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "audit": "npm audit --audit-level=high",
    "check": "npm run format:check && npm run lint && npm run typecheck && node --check ../scripts/check-whitespace.mjs",
    "test:contracts": "node --test tests/*.test.cjs",
    "test:components": "vitest run",
    "test:browser": "playwright test",
    "test": "npm run test:contracts && npm run test:components"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
